# ReplaySpec local environment template. Never put real credentials in this file.

# OpenRouter's free model router is the recommended local setup. It does not guarantee a Meta model.
MODEL_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_key_here

# Keep live frame analysis off until you are ready to send recordings to the provider.
REPLAYSPEC_LIVE_ANALYSIS=false

# Optional fixture support for local development and tests.
REPLAYSPEC_ALLOW_FIXTURES=1

# Optional fallback provider. Keep its key server-side and check account limits before enabling.
# MODEL_PROVIDER=groq
# GROQ_API_KEY=your_groq_key_here
